{% comment %}
  KITETZU · Drop Grid (Windbreaker) — White Dojo
  Settings: heading, eyebrow, collection, columns_desktop, show_numbering, show_status
  Mirrors featured-collection.liquid's prod-card-k pattern (red hover slash,
  --k-* color system) but as a full grid instead of a horizontal scroller.
{% endcomment %}

{%- assign the_collection = collections[section.settings.collection] | default: collection -%}
{%- assign cols = section.settings.columns_desktop | default: 4 -%}

<style>
  .drop-grid-section { padding: 64px 0 80px; background: var(--k-ink, #ffffff); }

  .drop-grid-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px 30px;
    gap: 16px;
  }
  .drop-grid-head__count {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--k-bone-35);
    white-space: nowrap;
  }

  .drop-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (min-width: 768px)  { .drop-grid { grid-template-columns: repeat(3, 1fr); gap: 32px 20px; } }
  @media (min-width: 1100px) { .drop-grid { grid-template-columns: repeat(var(--cols, 4), 1fr); } }

  .drop-card__img-wrap {
    position: relative;
    background: var(--k-ink-3, #ececee);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 13px;
  }
  .drop-card__img-wrap::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--k-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(.19,1,.22,1);
  }
  .drop-card:hover .drop-card__img-wrap::after { transform: scaleX(1); }
  .drop-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s, transform 0.6s cubic-bezier(.25,.46,.45,.94);
  }
  .drop-card:hover .drop-card__img-primary { transform: scale(1.04); }
  .drop-card__img-secondary { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s; }
  .drop-card:hover .drop-card__img-secondary { opacity: 1; }
  .drop-card:hover .drop-card__img-primary   { opacity: 0; }

  .drop-card__number {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--k-font-jp);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--k-bone-35);
    z-index: 1;
  }
  .drop-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 9px;
    color: #fff;
    z-index: 1;
  }
  .drop-card__badge--new     { background: var(--k-red); }
  .drop-card__badge--sale    { background: var(--k-bone); color: var(--k-ink); }
  .drop-card__badge--soldout { background: #e4e4e6; color: #6b6862; }

  .drop-card__type {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-bone-35);
    margin-bottom: 4px;
  }
  .drop-card__title {
    font-size: 13.5px;
    font-weight: 400;
    color: var(--k-bone);
    margin-bottom: 6px;
    line-height: 1.35;
    text-wrap: pretty;
    font-family: var(--k-font-body);
  }
  .drop-card__title a { transition: color 0.2s; }
  .drop-card__title a:hover { color: var(--k-red); }
  .drop-card__price-row { display: flex; align-items: center; margin-bottom: 5px; }
  .drop-card__price { font-size: 13.5px; font-weight: 500; color: var(--k-bone); }
  .drop-card__price--sale { color: var(--k-red); }
  .drop-card__price--compare { font-size: 12px; color: var(--k-bone-35); text-decoration: line-through; margin-left: 8px; }
  .drop-card__status {
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-bone-35);
  }
  .drop-card__status--soldout { color: var(--k-red); }

  .drop-grid__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 24px;
    color: var(--k-bone-35);
    font-size: 13px;
  }
</style>

<section class="drop-grid-section" id="drop-grid">
  <div class="drop-grid-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="k-eyebrow" style="margin-bottom: 10px;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="k-h2">{{ section.settings.heading | default: the_collection.title }}</h2>
    </div>
    {%- if the_collection != blank -%}
      <span class="drop-grid-head__count">{{ the_collection.products.size }} Teile</span>
    {%- endif -%}
  </div>

  <div class="drop-grid" style="--cols: {{ cols }};">
    {%- if the_collection != blank and the_collection.products.size > 0 -%}
      {%- for product in the_collection.products -%}
        {%- assign on_sale = false -%}
        {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
        {%- assign idx_str = forloop.index | append: '' -%}
        {%- if forloop.index < 10 -%}{%- assign idx_str = '0' | append: forloop.index -%}{%- endif -%}

        <div class="drop-card">
          <a href="{{ product.url }}" class="drop-card__img-wrap" style="display: block;">
            {%- if section.settings.show_numbering -%}
              <span class="drop-card__number">{{ idx_str }}</span>
            {%- endif -%}

            {%- if product.available == false -%}
              <span class="drop-card__badge drop-card__badge--soldout">Ausverkauft</span>
            {%- elsif product.tags contains 'new' -%}
              <span class="drop-card__badge drop-card__badge--new">Neu</span>
            {%- elsif on_sale -%}
              <span class="drop-card__badge drop-card__badge--sale">Sale</span>
            {%- endif -%}

            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  alt: product.title,
                  class: 'drop-card__img-primary',
                  widths: '300, 600',
                  sizes: '(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw'
              }}
              {%- if product.images[1] != blank -%}
                {{ product.images[1] | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    alt: product.title,
                    class: 'drop-card__img-secondary',
                    widths: '300, 600',
                    sizes: '(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw'
                }}
              {%- endif -%}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <p class="drop-card__type">{{ product.type }}</p>
          <h3 class="drop-card__title">
            <a href="{{ product.url }}" style="color: inherit;">{{ product.title }}</a>
          </h3>
          <div class="drop-card__price-row">
            <span class="drop-card__price {% if on_sale %}drop-card__price--sale{% endif %}">{{ product.price | money }}</span>
            {%- if on_sale -%}
              <span class="drop-card__price--compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.show_status -%}
            {%- if product.available == false -%}
              <span class="drop-card__status drop-card__status--soldout">Status · Ausverkauft</span>
            {%- else -%}
              <span class="drop-card__status">Status · Verfügbar</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <p class="drop-grid__empty">Noch keine Produkte in dieser Collection.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Drop Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leer lassen, um auf der Collection-Seite automatisch die aktuelle Collection zu verwenden."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Alle Teile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Windbreaker"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Spalten (Desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_numbering",
      "label": "Nummerierung zeigen (01, 02…)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Status-Zeile zeigen (Verfügbar / Ausverkauft)",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Drop Grid"
    }
  ]
}
{% endschema %}
