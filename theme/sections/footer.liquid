{% comment %}
  Section 9 · Footer
{% endcomment %}
<style>
  .site-footer { background:#f7f6f3; padding:56px 24px 32px; border-top:1px solid rgba(13,13,13,0.08); }
  .site-footer__inner { max-width:1440px; margin:0 auto; }
  .footer-grid { display:flex; flex-direction:column; gap:40px; }
  @media (min-width:768px) { .footer-grid { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:48px; } }
  .footer-brand__name { font-family:'Bebas Neue',sans-serif; font-size:24px; letter-spacing:0.1em; margin-bottom:12px; color:#0d0d0d; }
  .footer-brand__tagline { font-size:12px; color:rgba(13,13,13,0.4); line-height:1.75; max-width:220px; margin-bottom:20px; white-space:pre-line; }
  .footer-brand__socials { display:flex; gap:14px; align-items:center; }
  .footer-brand__social-link { color:#0d0d0d; line-height:0; transition:color 0.2s; }
  .footer-brand__social-link:hover { color:#e63322; }
  .footer-col__heading { font-size:9.5px; letter-spacing:0.2em; text-transform:uppercase; color:rgba(13,13,13,0.3); margin-bottom:16px; font-weight:500; }
  .footer-col__list { list-style:none; display:flex; flex-direction:column; gap:10px; }
  .footer-col__link { font-size:13px; color:rgba(13,13,13,0.55); transition:color 0.2s; }
  .footer-col__link:hover { color:#0d0d0d; }
  .footer-col__text { font-size:12px; line-height:1.6; color:rgba(13,13,13,0.55); max-width:220px; margin:0 0 14px; }
  .footer-withdraw { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:12px 22px; background:#0d0d0d; border:1px solid #0d0d0d; color:#ffffff; font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; text-align:center; transition:background 0.2s, border-color 0.2s, transform 0.12s cubic-bezier(.16,1,.3,1); }
  .footer-withdraw:hover { background:#e63322; border-color:#e63322; }
  .footer-withdraw:active { transform:scale(0.97); }
  @media (prefers-reduced-motion:reduce) { .footer-withdraw { transition:none; } .footer-withdraw:active { transform:none; } }
</style>
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-grid">
      <div>
        <div class="footer-brand__name">{{ shop.name }}</div>
        {%- for block in section.blocks -%}{%- if block.type == 'brand_block' -%}
          {%- if block.settings.tagline != blank -%}<p class="footer-brand__tagline">{{ block.settings.tagline }}</p>{%- endif -%}
          <div class="footer-brand__socials">
            {%- if block.settings.instagram_url != blank -%}<a href="{{ block.settings.instagram_url }}" class="footer-brand__social-link" aria-label="Instagram" {{ block.shopify_attributes }}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>{%- endif -%}
            {%- if block.settings.tiktok_url != blank -%}<a href="{{ block.settings.tiktok_url }}" class="footer-brand__social-link" aria-label="TikTok" {{ block.shopify_attributes }}><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.77 0 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-6.34 6.29 6.34 6.34 0 0 0 12.68 0V8.75a8.27 8.27 0 0 0 4.83 1.55V6.85a4.85 4.85 0 0 1-1.86-.16z"></path></svg></a>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- for block in section.blocks -%}{%- if block.type == 'link_list' -%}
        <div {{ block.shopify_attributes }}>
          <h4 class="footer-col__heading">{{ block.settings.heading }}</h4>
          {%- assign nav = linklists[block.settings.menu] -%}
          {%- if nav != blank -%}<ul class="footer-col__list">{%- for link in nav.links -%}<li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
        </div>
      {%- endif -%}{%- endfor -%}
      {%- for block in section.blocks -%}{%- if block.type == 'withdrawal_button' -%}
        {%- assign withdrawal_url = block.settings.link | default: pages['vertrag-widerrufen'].url -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h4 class="footer-col__heading">{{ block.settings.heading }}</h4>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="footer-col__text">{{ block.settings.text }}</p>{%- endif -%}
          <a href="{{ withdrawal_url }}" class="footer-withdraw">{{ block.settings.label }}</a>
        </div>
      {%- endif -%}{%- endfor -%}
    </div>
  </div>
</footer>
{%- if request.page_type == 'index' -%}
  {%- liquid
    assign brand_block = section.blocks | where: 'type', 'brand_block' | first
    assign instagram_url = brand_block.settings.instagram_url
    assign tiktok_url = brand_block.settings.tiktok_url
    assign returns_page = pages['versand-retouren']
    assign return_country = shop.address.country_code | default: localization.country.iso_code
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: '/' | json }},
      {%- if section.settings.seo_logo != blank %}
        "logo": {{ section.settings.seo_logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      {%- if shop.description != blank %}
        "description": {{ shop.description | json }},
      {%- endif %}
      {%- if instagram_url != blank or tiktok_url != blank %}
        "sameAs": [
          {%- if instagram_url != blank -%}{{ instagram_url | json }}{%- endif -%}
          {%- if instagram_url != blank and tiktok_url != blank -%},{%- endif -%}
          {%- if tiktok_url != blank -%}{{ tiktok_url | json }}{%- endif -%}
        ],
      {%- endif %}
      {%- if section.settings.return_days > 0 %}
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": [
            {%- for country in localization.available_countries -%}
              {{ country.iso_code | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          {%- if return_country != blank %}
            "returnPolicyCountry": {{ return_country | json }},
          {%- endif %}
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": {{ section.settings.return_days }},
          {%- if returns_page != empty %}
            "merchantReturnLink": {{ shop.url | append: returns_page.url | json }},
          {%- endif %}
          "returnMethod": "https://schema.org/ReturnByMail"
        },
      {%- endif %}
      "email": {{ shop.email | json }},
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": {{ shop.email | json }},
        "availableLanguage": {{ request.locale.iso_code | json }}
      }
    }
  </script>
{%- endif -%}
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Google & KI-Suche" },
    { "type": "paragraph", "content": "Fließt als strukturierte Daten (Schema.org) in die Startseite ein. Social-Links kommen aus dem Brand-Block." },
    { "type": "image_picker", "id": "seo_logo", "label": "Logo für Suchmaschinen", "info": "Dunkles Logo auf hellem Hintergrund, mindestens 112 × 112 px." },
    { "type": "number", "id": "return_days", "label": "Rückgabefrist in Tagen", "info": "Muss mit deiner Rückgaberichtlinie übereinstimmen. Leer lassen, um keine Rückgabe-Daten auszugeben." }
  ],
  "blocks": [
    { "type": "brand_block", "name": "Brand", "limit": 1, "settings": [ { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Anime fits. Aura farming.\nIn Deutschland gegründet. Weltweit getragen." }, { "type": "url", "id": "instagram_url", "label": "Instagram URL" }, { "type": "url", "id": "tiktok_url", "label": "TikTok URL" } ] },
    { "type": "link_list", "name": "Link list", "limit": 3, "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" }, { "type": "link_list", "id": "menu", "label": "Menu" } ] },
    { "type": "withdrawal_button", "name": "Widerruf-Button", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Überschrift", "default": "Widerruf" }, { "type": "text", "id": "text", "label": "Kurztext (optional)" }, { "type": "text", "id": "label", "label": "Button-Text", "info": "Gesetzlich vorgesehen: „Vertrag widerrufen“.", "default": "Vertrag widerrufen" }, { "type": "url", "id": "link", "label": "Link", "info": "Leer lassen, um die Seite „Vertrag widerrufen“ zu verwenden." } ] }
  ],
  "presets": [{ "name": "Footer", "blocks": [ { "type": "brand_block" }, { "type": "link_list", "settings": { "heading": "Shop" } }, { "type": "link_list", "settings": { "heading": "Info" } }, { "type": "link_list", "settings": { "heading": "Service" } } ] }]
}
{% endschema %}