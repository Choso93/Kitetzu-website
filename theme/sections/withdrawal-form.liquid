{% comment %}
  KITETZU · Widerruf — Online-Widerrufsfunktion (Footer-Button "Vertrag widerrufen" → diese Seite → "Widerruf bestätigen")
{% endcomment %}
<style>
  .widerruf { padding:56px 24px 96px; background:var(--k-ink,#ffffff); }
  .widerruf__inner { max-width:1440px; margin:0 auto; }
  .widerruf__form { max-width:760px; }
  .widerruf__title { font-family:var(--k-font-display); font-size:clamp(52px,10vw,104px); line-height:.9; letter-spacing:.02em; text-transform:uppercase; color:var(--k-bone); margin:0 0 20px; }
  .widerruf__intro { font-size:16px; line-height:1.7; color:var(--k-bone-70); margin:0 0 36px; max-width:60ch; text-wrap:pretty; }
  .widerruf__field { margin-bottom:24px; }
  .widerruf__label { display:block; font-size:14px; font-weight:500; color:var(--k-bone); margin-bottom:8px; }
  .widerruf__input, .widerruf__textarea { display:block; width:100%; box-sizing:border-box; background:#ffffff; border:1px solid rgba(20,20,22,.2); border-radius:0; color:var(--k-bone); font-family:var(--k-font-body); font-size:16px; padding:15px 16px; outline:none; }
  .widerruf__textarea { min-height:132px; resize:vertical; }
  .widerruf__input:focus, .widerruf__input:focus-visible, .widerruf__textarea:focus, .widerruf__textarea:focus-visible { outline:none; border-color:rgba(20,20,22,.65); }
  .widerruf__required { font-size:14px; color:var(--k-bone-55); margin:4px 0 28px; }
  .widerruf__actions { display:flex; justify-content:flex-end; }
  .widerruf__privacy { font-size:12px; line-height:1.6; color:var(--k-bone-55); margin:20px 0 0; text-align:right; }
  .widerruf__privacy a { color:var(--k-bone); text-decoration:underline; }
  .widerruf__error { border:1px solid var(--k-red); color:var(--k-red-deep); font-size:14px; line-height:1.6; padding:14px 16px; margin-bottom:24px; }
  .widerruf__error ul { margin:0; padding-left:18px; }
  .widerruf__success { border-top:2px solid var(--k-red); padding-top:28px; max-width:60ch; }
  .widerruf__success-title { font-family:var(--k-font-display); font-size:clamp(34px,6vw,56px); line-height:.95; letter-spacing:.03em; text-transform:uppercase; color:var(--k-bone); margin:0 0 14px; }
  .widerruf__success-text { font-size:16px; line-height:1.7; color:var(--k-bone-70); margin:0; }
  .widerruf__notes { margin-top:44px; max-width:60ch; font-size:14px; line-height:1.7; color:var(--k-bone-55); }
  .widerruf__notes a { color:var(--k-bone); text-decoration:underline; }
  .widerruf__notes p { margin:0; }
  @media (max-width:560px) { .widerruf { padding:40px 20px 72px; } .widerruf__actions .k-btn { width:100%; justify-content:center; } .widerruf__privacy { text-align:left; } }
</style>
<section class="widerruf" id="widerruf">
  <div class="widerruf__inner">
    <h1 class="widerruf__title">{{ section.settings.heading }}</h1>
    {%- form 'contact', id: 'widerruf-form', class: 'widerruf__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="widerruf__success" role="status">
          <h2 class="widerruf__success-title">{{ section.settings.success_heading }}</h2>
          {%- if section.settings.success_text != blank -%}<p class="widerruf__success-text">{{ section.settings.success_text }}</p>{%- endif -%}
        </div>
      {%- else -%}
        {%- if section.settings.intro != blank -%}<p class="widerruf__intro">{{ section.settings.intro }}</p>{%- endif -%}
        {%- if form.errors -%}
          <div class="widerruf__error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <input type="hidden" name="contact[Widerruf]" value="{{ section.settings.intro | escape }}">
        <div class="widerruf__field">
          <label class="widerruf__label" for="widerruf-order">{{ section.settings.label_order }}*</label>
          <input class="widerruf__input" id="widerruf-order" type="text" name="contact[Bestellnummer]" autocomplete="off" required>
        </div>
        <div class="widerruf__field">
          <label class="widerruf__label" for="widerruf-name">{{ section.settings.label_name }}*</label>
          <input class="widerruf__input" id="widerruf-name" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
        </div>
        <div class="widerruf__field">
          <label class="widerruf__label" for="widerruf-email">{{ section.settings.label_email }}*</label>
          <input class="widerruf__input" id="widerruf-email" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
        <div class="widerruf__field">
          <label class="widerruf__label" for="widerruf-note">{{ section.settings.label_note }}</label>
          <textarea class="widerruf__textarea" id="widerruf-note" name="contact[body]" rows="4">{{ form.body }}</textarea>
        </div>
        <p class="widerruf__required">{{ section.settings.required_note }}</p>
        <div class="widerruf__actions">
          <button type="submit" class="k-btn k-btn--red">{{ section.settings.button_label }}</button>
        </div>
        {%- if section.settings.privacy_text != blank -%}
          <p class="widerruf__privacy">
            {{- section.settings.privacy_text }}
            {%- if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>.{%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if page.content != blank -%}
      <div class="widerruf__notes">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Widerruf-Formular",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Vertrag widerrufen" },
    { "type": "textarea", "id": "intro", "label": "Widerrufserklärung", "info": "Steht über dem Formular und wird mit jeder Einsendung mitgeschickt.", "default": "Hiermit widerrufe ich den von mir abgeschlossenen Vertrag über den Kauf der folgenden Waren." },
    { "type": "header", "content": "Formularfelder" },
    { "type": "text", "id": "label_order", "label": "Feld: Bestellnummer", "default": "Bestellnummer" },
    { "type": "text", "id": "label_name", "label": "Feld: Name", "default": "Vor- und Nachname" },
    { "type": "text", "id": "label_email", "label": "Feld: E-Mail", "default": "E-Mail" },
    { "type": "text", "id": "label_note", "label": "Feld: Anmerkung", "default": "Anmerkung (Widerruf des gesamten Vertrages oder einzelne Positionen)" },
    { "type": "text", "id": "required_note", "label": "Hinweis Pflichtfelder", "default": "Die mit * gekennzeichneten Felder sind Pflichtfelder." },
    { "type": "text", "id": "button_label", "label": "Button zum Absenden", "default": "Widerruf bestätigen" },
    { "type": "text", "id": "privacy_text", "label": "Datenschutzhinweis", "info": "Die Datenschutzerklärung wird automatisch dahinter verlinkt.", "default": "Ihre Angaben verwenden wir nur zur Bearbeitung Ihres Widerrufs. Mehr dazu in unserer" },
    { "type": "header", "content": "Nach dem Absenden" },
    { "type": "text", "id": "success_heading", "label": "Überschrift", "default": "Ihr Widerruf ist bei uns eingegangen." },
    { "type": "textarea", "id": "success_text", "label": "Text", "info": "Nur Zusagen machen, die ihr auch einhaltet, z. B. die Bestätigung per E-Mail.", "default": "Vielen Dank. Wir bestätigen den Eingang Ihres Widerrufs unverzüglich per E-Mail an die angegebene Adresse." }
  ],
  "presets": [{ "name": "Widerruf-Formular" }]
}
{% endschema %}
