{% comment %}
  KITETZU · Das Arsenal — Produkt-Karussell (White Dojo)
{% endcomment %}
{%- assign featured = section.settings.collection -%}
{%- assign products_to_show = section.settings.products_to_show | default: 4 -%}
<style>
  .featured-collection { padding:72px 0 52px; background:var(--k-ink,#ffffff); border-top:1px solid var(--k-line); position:relative; overflow:hidden; }
  .featured-collection__kanji { position:absolute; top:-30px; right:-10px; font-size:clamp(140px,20vw,260px); z-index:0; }
  .featured-collection__head { position:relative; z-index:1; }
  .prod-scroll { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding:0 24px 4px; position:relative; z-index:1; }
  .prod-scroll::-webkit-scrollbar { display:none; }
  .prod-card-k { flex:0 0 260px; scroll-snap-align:start; }
  @media (min-width:768px) { .prod-card-k { flex:0 0 calc(50% - 18px); } }
  @media (min-width:1100px) { .prod-card-k { flex:0 0 calc(25% - 9px); } }
  .prod-card-k__img-wrap { position:relative; background:var(--k-ink-3,#ececee); aspect-ratio:3/4; overflow:hidden; margin-bottom:12px; }
  .prod-card-k__img-wrap::after { content:""; position:absolute; top:0; left:0; right:0; height:2px; background:var(--k-red); transform:scaleX(0); transform-origin:left; transition:transform .45s cubic-bezier(.19,1,.22,1); }
  .prod-card-k:hover .prod-card-k__img-wrap::after { transform:scaleX(1); }
  .prod-card-k__img-wrap img { width:100%; height:100%; object-fit:cover; display:block; transition:opacity .3s,transform .6s cubic-bezier(.25,.46,.45,.94); }
  .prod-card-k:hover .prod-card-k__img-primary { transform:scale(1.04); }
  .prod-card-k__img-secondary { position:absolute; inset:0; opacity:0; transition:opacity .35s; }
  .prod-card-k:hover .prod-card-k__img-secondary { opacity:1; } .prod-card-k:hover .prod-card-k__img-primary { opacity:0; }
  .prod-card-k__badge { position:absolute; top:10px; left:10px; font-size:8.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; padding:5px 9px; color:#fff; z-index:1; }
  .prod-card-k__badge--new { background:var(--k-red); } .prod-card-k__badge--sale { background:var(--k-bone); color:var(--k-ink); }
  .qa-bar { position:absolute; bottom:0; left:0; right:0; background:var(--k-red); padding:13px; text-align:center; transform:translateY(100%); transition:transform .28s ease; z-index:1; }
  .prod-card-k:hover .qa-bar { transform:translateY(0); }
  .qa-bar span { font-size:10.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; color:#fff; }
  .prod-card-k__vendor { font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--k-bone-35); margin-bottom:4px; }
  .prod-card-k__title { font-size:13.5px; font-weight:400; color:var(--k-bone); margin-bottom:6px; line-height:1.35; text-wrap:pretty; font-family:var(--k-font-body); text-transform:none; letter-spacing:0; }
  .prod-card-k__title a { transition:color .2s; } .prod-card-k__title a:hover { color:var(--k-red); }
  .prod-card-k__price { font-size:13.5px; font-weight:500; color:var(--k-bone); }
  .prod-card-k__price--sale { color:var(--k-red); } .prod-card-k__price--compare { font-size:12px; color:var(--k-bone-35); text-decoration:line-through; margin-left:8px; }
  .prod-scroll__view-all { display:flex; align-items:center; justify-content:center; aspect-ratio:3/4; border:1px solid var(--k-line); cursor:pointer; text-decoration:none; transition:border-color .2s; }
  .prod-scroll__view-all:hover { border-color:var(--k-red); }
  .scroll-dots { display:flex; gap:5px; justify-content:center; padding:22px 0 0; position:relative; z-index:1; }
  .scroll-dot { height:2px; display:block; background:rgba(20,20,22,.18); transition:width .35s cubic-bezier(.4,0,.2,1),background .35s ease; width:7px; }
  .scroll-dot--active { width:22px; background:var(--k-red); }
</style>
<section class="featured-collection">
  {%- if section.settings.kanji != blank -%}<div class="featured-collection__kanji k-kanji-ghost" aria-hidden="true">{{ section.settings.kanji }}</div>{%- endif -%}
  <div style="max-width:1440px;margin:0 auto">
    <div class="featured-collection__head" style="padding:0 24px 30px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow" style="margin-bottom:10px">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="k-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if featured != blank -%}<a href="{{ featured.url }}" class="k-link">Alle ansehen</a>{%- endif -%}
    </div>
    <div class="prod-scroll" id="prod-scroll-{{ section.id }}">
      {%- if featured != blank -%}
        {%- for product in featured.products limit: products_to_show -%}
          {%- assign on_sale = false -%}{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
          <div class="prod-card-k">
            <div class="prod-card-k__img-wrap">
              {%- assign card_alt = product.featured_image.alt | default: product.title -%}
              {%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: card_alt, class: 'prod-card-k__img-primary', widths: '300, 600', sizes: '(min-width:1100px) 25vw,(min-width:768px) 50vw,260px' }}{%- if section.settings.show_second_image and product.images[1] != blank -%}{{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', class: 'prod-card-k__img-secondary', widths: '300, 600', sizes: '(min-width:1100px) 25vw,(min-width:768px) 50vw,260px' }}{%- endif -%}{%- endif -%}
              {%- if product.tags contains 'new' or forloop.first -%}<span class="prod-card-k__badge prod-card-k__badge--new">Neu</span>{%- elsif on_sale -%}<span class="prod-card-k__badge prod-card-k__badge--sale">Sale</span>{%- endif -%}
              {%- if section.settings.enable_quick_add -%}<a href="{{ product.url }}" class="qa-bar"><span>Ansehen</span></a>{%- endif -%}
            </div>
            <p class="prod-card-k__vendor">{{ product.type }}</p>
            <h3 class="prod-card-k__title"><a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a></h3>
            <div style="display:flex;align-items:center">
              <span class="prod-card-k__price {% if on_sale %}prod-card-k__price--sale{% endif %}">{{ product.price | money }}</span>
              {%- if on_sale -%}<span class="prod-card-k__price--compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}<div class="prod-card-k"><div class="prod-card-k__img-wrap">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div><p class="prod-card-k__vendor">Kategorie</p><h3 class="prod-card-k__title">Produktname {{ i }}</h3><span class="prod-card-k__price">€0.00</span></div>{%- endfor -%}
      {%- endif -%}
      <a href="{{ featured.url | default: routes.collections_url }}" class="prod-scroll__view-all prod-card-k"><div style="text-align:center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="margin:0 auto 10px;opacity:.35;display:block;color:var(--k-bone)"><path d="M5 12h14M12 5l7 7-7 7"></path></svg><p style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--k-bone-35)">Alle ansehen</p></div></a>
    </div>
    <div class="scroll-dots" id="scroll-dots-{{ section.id }}" aria-hidden="true">
      {%- assign dot_count = products_to_show | plus: 1 | at_most: 5 -%}
      {%- for i in (1..dot_count) -%}<span class="scroll-dot {% if forloop.first %}scroll-dot--active{% endif %}" data-dot="{{ forloop.index0 }}"></span>{%- endfor -%}
    </div>
  </div>
</section>
<script>
(function(){
  var scroll=document.getElementById('prod-scroll-{{ section.id }}'),dots=Array.from(document.querySelectorAll('#scroll-dots-{{ section.id }} [data-dot]'));
  if(!scroll||!dots.length)return;
  function activate(idx){dots.forEach(function(d,i){var a=i===idx;d.style.width=a?'22px':'7px';d.style.background=a?'#e63322':'rgba(20,20,22,0.18)';});}
  var ticking=false;
  scroll.addEventListener('scroll',function(){if(ticking)return;ticking=true;requestAnimationFrame(function(){var c=scroll.querySelector('.prod-card-k');if(c){var idx=Math.round(scroll.scrollLeft/(c.offsetWidth+12));activate(Math.max(0,Math.min(dots.length-1,idx)));}ticking=false;});},{passive:true});
})();
</script>
{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Das Arsenal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Neuester Drop" },
    { "type": "text", "id": "kanji", "label": "Ghost-Kanji", "default": "新" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add", "default": true },
    { "type": "checkbox", "id": "show_second_image", "label": "Show second image on hover", "default": true }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}