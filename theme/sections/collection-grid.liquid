{% comment %}
  KITETZU · Kategorien — Wähle deine Waffe (White Dojo)
{% endcomment %}
<style>
  .cat-grid { display:flex; flex-direction:column; gap:3px; }
  .cat-card { cursor:pointer; overflow:hidden; position:relative; display:flex; flex-direction:column; justify-content:flex-end; min-height:56vw; background:var(--k-ink-2,#f4f4f5); }
  .cat-card--tall { min-height:72vw; } .cat-card--mid { min-height:52vw; } .cat-card--accent { min-height:40vw; }
  .cat-card__img-layer { position:absolute; inset:0; transition:transform .65s cubic-bezier(.25,.46,.45,.94),filter .65s ease; will-change:transform; filter:saturate(.85); }
  .cat-card__img-layer img { width:100%; height:100%; object-fit:cover; display:block; }
  .cat-card:hover .cat-card__img-layer { transform:scale(1.06); filter:saturate(1); }
  .cat-card__overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(255,255,255,.92) 0%, rgba(255,255,255,.2) 55%, rgba(255,255,255,.35) 100%); }
  .cat-card__slash { position:absolute; top:0; left:0; right:0; height:2px; background:var(--k-red); transform:scaleX(0); transform-origin:left; transition:transform .5s cubic-bezier(.19,1,.22,1); }
  .cat-card:hover .cat-card__slash { transform:scaleX(1); }
  .cat-card__index { position:absolute; top:16px; left:18px; font-family:var(--k-font-jp); font-weight:600; font-size:15px; color:var(--k-bone-35); letter-spacing:.2em; z-index:1; }
  .cat-card__footer { position:relative; z-index:1; padding:22px; display:flex; justify-content:space-between; align-items:flex-end; }
  .cat-card--mid .cat-card__footer, .cat-card--accent .cat-card__footer { padding:18px; }
  .cat-card__label-eyebrow { font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; color:var(--k-red); display:block; margin-bottom:5px; font-weight:700; }
  .cat-card__label { font-family:var(--k-font-display); letter-spacing:.04em; line-height:1; display:block; color:var(--k-bone); }
  .cat-card--tall .cat-card__label { font-size:52px; } .cat-card--mid .cat-card__label, .cat-card--accent .cat-card__label { font-size:38px; }
  .cat-card__count { font-size:10.5px; color:var(--k-bone-35); letter-spacing:.06em; margin-top:4px; display:block; }
  .cat-card__arrow { display:flex; align-items:center; justify-content:center; border:1px solid rgba(20,20,22,.3); color:var(--k-bone); flex-shrink:0; transition:background .2s,border-color .2s,color .2s; }
  .cat-card--tall .cat-card__arrow { width:38px; height:38px; } .cat-card--mid .cat-card__arrow, .cat-card--accent .cat-card__arrow { width:34px; height:34px; }
  .cat-card:hover .cat-card__arrow { background:var(--k-red); border-color:var(--k-red); color:#fff; }
  @media (min-width:768px) { .cat-grid { display:grid; grid-template-columns:2fr 1fr; grid-template-rows:56vh 32vh; gap:3px; } .cat-card--tall { grid-column:1; grid-row:1/3; min-height:0; } .cat-card--mid { grid-column:2; grid-row:1; min-height:0; } .cat-card--accent { grid-column:2; grid-row:2; min-height:0; } }
  @media (min-width:1100px) { .cat-grid { grid-template-columns:2fr 1fr 1fr; grid-template-rows:76vh; } .cat-card--tall { grid-column:1; grid-row:1; } .cat-card--mid { grid-column:2; grid-row:1; } .cat-card--accent { grid-column:3; grid-row:1; } }
</style>
<section style="padding-top:64px;background:var(--k-ink,#ffffff)">
  <div style="padding:0 24px 26px;display:flex;align-items:flex-end;justify-content:space-between;max-width:1440px;margin:0 auto;gap:16px">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow" style="margin-bottom:10px">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="k-h2">{{ section.settings.heading }}</h2>
    </div>
    <a href="{{ routes.collections_url }}" class="k-link">Alle ansehen</a>
  </div>
  <div class="cat-grid" style="padding:0 3px 3px">
    {%- assign kanji_numbers = '壱,弐,参,四,伍,六' | split: ',' -%}
    {%- for block in section.blocks -%}{%- if block.type == 'collection_block' -%}
      {%- assign col = block.settings.collection -%}
      {%- assign label = block.settings.custom_label | default: col.title -%}
      {%- assign card_mod = 'cat-card--mid' -%}
      {%- if forloop.index == 1 -%}{%- assign card_mod = 'cat-card--tall' -%}{%- endif -%}
      {%- if forloop.index == 3 -%}{%- assign card_mod = 'cat-card--accent' -%}{%- endif -%}
      <div class="cat-card {{ card_mod }}" {{ block.shopify_attributes }}>
        <div class="cat-card__img-layer">
          {%- if col.featured_image != blank -%}{{ col.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: label, widths: '600, 900', sizes: '(min-width:1100px) 33vw,(min-width:768px) 50vw,100vw' }}{%- else -%}<div style="width:100%;height:100%;background:var(--k-ink-3,#ececee)"></div>{%- endif -%}
          <div class="cat-card__overlay"></div>
        </div>
        <div class="cat-card__slash" aria-hidden="true"></div>
        <span class="cat-card__index" aria-hidden="true">{{ kanji_numbers[forloop.index0] }} / {{ forloop.index | prepend: '0' }}</span>
        <div class="cat-card__footer">
          <div>
            {%- if forloop.index == 1 -%}<span class="cat-card__label-eyebrow">Collection</span>{%- endif -%}
            <span class="cat-card__label">{{ label }}</span>
            {%- if section.settings.show_product_count -%}<span class="cat-card__count">{{ col.all_products_count }} Produkte</span>{%- endif -%}
          </div>
          <a href="{{ col.url }}" class="cat-card__arrow" aria-label="{{ label }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
        </div>
      </div>
    {%- endif -%}{%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection Grid",
  "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kategorien" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Wähle deine Waffe" }, { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": false } ],
  "blocks": [{ "type": "collection_block", "name": "Collection", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "custom_label", "label": "Custom label" } ] }],
  "max_blocks": 6,
  "presets": [{ "name": "Collection Grid", "blocks": [ { "type": "collection_block", "settings": { "custom_label": "DROP 0" } }, { "type": "collection_block", "settings": { "custom_label": "CLASSIC" } }, { "type": "collection_block", "settings": { "custom_label": "NÄCHSTE DROPS" } } ] }]
}
{% endschema %}