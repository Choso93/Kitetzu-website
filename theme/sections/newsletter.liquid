{% comment %}
  KITETZU · Newsletter — Der innere Zirkel (White Dojo)
{% endcomment %}
<style>
  .newsletter-section { padding:69px 24px; text-align:center; border-top:1px solid var(--k-line); background:{{ section.settings.bg_color }}; position:relative; overflow:hidden; }
  .newsletter__inner { max-width:480px; margin:0 auto; position:relative; }
  .newsletter__heading { font-family:var(--k-font-display); font-size:clamp(38px,9vw,58px); letter-spacing:.04em; line-height:.96; margin-bottom:14px; color:var(--k-bone); }
  .newsletter__subheading { font-size:13px; color:var(--k-bone-55); line-height:1.7; margin-bottom:32px; text-wrap:pretty; }
  .newsletter__form { display:flex; max-width:380px; margin:0 auto; }
  .newsletter__input { flex:1; background:var(--k-ink,#ffffff); border:1px solid rgba(20,20,22,.18); border-right:none; color:var(--k-bone); font-size:13px; padding:15px 16px; outline:none; font-family:var(--k-font-body); min-width:0; }
  .newsletter__input::placeholder { color:var(--k-bone-35); }
  .newsletter__input:focus, .newsletter__input:focus-visible { outline:none; border-color:rgba(20,20,22,.18); }
  .newsletter__btn { background:transparent; color:var(--k-red); border:1px solid var(--k-red); padding:15px 22px; font-size:10.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; white-space:nowrap; font-family:var(--k-font-body); flex-shrink:0; transition:background .2s,color .2s; }
  .newsletter__btn:hover { background:var(--k-red); color:#fff; }
  .newsletter__disclaimer { font-size:10px; color:var(--k-bone-35); margin-top:14px; letter-spacing:.04em; }
  .newsletter__success { font-size:13px; color:var(--k-bone); padding:16px 0; font-weight:500; letter-spacing:.05em; }
</style>
<section class="newsletter-section" id="newsletter">
  <div class="newsletter__inner">
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="newsletter__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- form 'customer', id: 'newsletter-form-{{ section.id }}' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">Willkommen im inneren Zirkel. 鬼徹</p>
      {%- else -%}
        <div class="newsletter__form">
          <input class="newsletter__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" autocomplete="email" required>
          <button class="newsletter__btn" type="submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.errors -%}<p style="color:var(--k-red);font-size:12px;margin-top:8px">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.disclaimer != blank -%}<p class="newsletter__disclaimer">{{ section.settings.disclaimer }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Erster Zugriff. Oder leer ausgehen." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Du erfährst von jedem Drop 24 Stunden vor allen anderen — plus 10% auf deine erste Bestellung. Code: WELCOME10" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "E-Mail" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "BEITRETEN" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Mit Absenden des Formulars akzeptierst Du unsere Datenschutzbestimmungen." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f4f4f5" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}