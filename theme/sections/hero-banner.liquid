{% comment %}
  KITETZU · White Dojo Hero — 鬼徹
{% endcomment %}
{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_top = overlay_alpha | times: 0.92 | round: 2
  assign overlay_mid = overlay_alpha | times: 0.45 | round: 2
  assign hero_desktop = section.settings.image | default: section.settings.mobile_image
  assign hero_mobile = section.settings.mobile_image | default: section.settings.image
  assign hero_alt = section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | strip
  if hero_desktop.alt != blank
    assign hero_alt = hero_desktop.alt
  endif
  assign hero_video = section.settings.video
  assign hero_video_mobile = section.settings.mobile_video
  assign hero_poster_video = hero_video | default: hero_video_mobile
  assign hero_video_main = hero_video | default: hero_video_mobile
-%}
{%- capture hero_picture -%}
  {%- if hero_desktop != blank -%}
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="{{ hero_mobile | image_url: width: 375 }} 375w, {{ hero_mobile | image_url: width: 750 }} 750w"
        sizes="100vw"
      >
      {{ hero_desktop | image_url: width: 1440 | image_tag: loading: 'eager', fetchpriority: 'high', alt: hero_alt, widths: '750, 1100, 1440', sizes: '100vw' }}
    </picture>
  {%- endif -%}
{%- endcapture -%}
<style>
  @keyframes heroFadeUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }
  @keyframes heroKanji { 0%,100% { opacity:.9; transform:translateY(0); } 50% { opacity:.55; transform:translateY(-14px); } }
  @keyframes heroSlash { from { transform:scaleX(0); } to { transform:scaleX(1); } }
  .hero-dojo { position:relative; min-height:{{ section.settings.min_height }}svh; display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; background:var(--k-ink,#ffffff); }
  .hero-dojo__img-layer { position:absolute; inset:0; }
  .hero-dojo__img-layer picture { display:block; width:100%; height:100%; }
  .hero-dojo__img-layer img { width:100%; height:100%; object-fit:cover; object-position:center top; display:block; }
  .hero-dojo__video { position:absolute; inset:0; display:block; }
  .hero-dojo__video picture, .hero-dojo__video img, .hero-dojo__video video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .hero-dojo__video img { object-position:center top; }
  .hero-dojo__video video { object-position:center; }
  .hero-dojo__video video { opacity:0; transition:opacity .4s cubic-bezier(.16,1,.3,1); }
  .hero-dojo__video[data-playing] video { opacity:1; }
  .hero-dojo__video[data-static] video, .hero-dojo__video[data-static] .hero-dojo__video-toggle { display:none; }
  .hero-dojo__video-toggle { position:absolute; right:20px; bottom:20px; z-index:3; width:44px; height:44px; padding:0; border-radius:50%; border:1px solid rgba(255,255,255,.35); background:rgba(20,20,22,.6); color:#ffffff; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:transform .12s cubic-bezier(.16,1,.3,1), background-color .15s cubic-bezier(.16,1,.3,1); }
  .hero-dojo__video-toggle:hover { background:rgba(20,20,22,.8); }
  .hero-dojo__video-toggle:active { transform:scale(.93); }
  .hero-dojo__video-toggle .svg-wrapper { display:flex; width:14px; height:14px; }
  .hero-dojo__video-toggle svg { width:100%; height:100%; }
  .hero-dojo__video-toggle .hero-dojo__icon-play, .hero-dojo__video[data-paused] .hero-dojo__icon-pause { display:none; }
  .hero-dojo__video[data-paused] .hero-dojo__icon-play { display:flex; }
  .hero-dojo__overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(20,20,22,{{ overlay_top }}) 0%, rgba(20,20,22,{{ overlay_mid }}) 45%, rgba(20,20,22,0.15) 100%); }
  .hero-dojo__kanji { position:absolute; top:6%; right:2%; z-index:1; display:flex; flex-direction:column; font-size:clamp(150px,26vw,380px); animation:heroKanji 9s ease-in-out infinite; }
  .hero-dojo__content { position:relative; z-index:2; padding:40px 24px 30px; max-width:1440px; margin:0 auto; width:100%; animation:heroFadeUp .9s ease both .1s; }
  .hero-dojo__heading { font-family:var(--k-font-display); font-size:clamp(84px,22vw,210px); line-height:.86; letter-spacing:.015em; color:#ffffff; margin:14px 0 0; text-wrap:balance; }
  .hero-dojo__ghostline { display:block; font-family:var(--k-font-display); font-size:clamp(46px,11vw,120px); line-height:.92; letter-spacing:.03em; color:#ffffff; -webkit-text-stroke:0; margin:6px 0 34px; }
  .hero-dojo__sub { font-family:var(--k-font-body); font-size:clamp(13px,1.9vw,19px); font-weight:500; letter-spacing:.28em; text-transform:uppercase; line-height:1.4; color:#ffffff; margin:-14px 0 34px; text-wrap:balance; }
  .hero-dojo .k-kanji-ghost { -webkit-text-stroke:1px rgba(255,255,255,.2); }
  .hero-dojo .k-vertical { color:rgba(255,255,255,.6); }
  .hero-dojo .k-link { color:#ffffff; border-color:rgba(255,255,255,.35); }
  .hero-dojo .k-link:hover { color:var(--k-red); border-color:var(--k-red); }
  .hero-dojo__ctas { display:flex; gap:18px; align-items:center; flex-wrap:wrap; animation:heroFadeUp .9s ease both .35s; }
  .hero-dojo__vertical { position:absolute; right:22px; bottom:120px; z-index:2; display:none; }
  .hero-dojo__meta { position:relative; z-index:2; border-top:1px solid rgba(255,255,255,.18); margin-top:34px; }
  .hero-dojo__meta-inner { max-width:1440px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.7); }
  .hero-dojo__meta-inner .dot { width:4px; height:4px; background:var(--k-red); transform:rotate(45deg); flex-shrink:0; }
  .hero-dojo__slashline { position:absolute; top:0; left:0; right:0; height:2px; z-index:3; background:linear-gradient(90deg, var(--k-red), transparent 60%); transform-origin:left; animation:heroSlash 1.2s cubic-bezier(.19,1,.22,1) both .2s; }
  @media (min-width:900px) { .hero-dojo__vertical { display:block; } .hero-dojo__ghostline { font-size:clamp(46px,10vw,108px); } }
  @media (max-width:767px) { .hero-dojo__kanji { right:-4%; top:4%; } }
  @media (prefers-reduced-motion:reduce) { .hero-dojo__kanji, .hero-dojo__content, .hero-dojo__ctas, .hero-dojo__slashline { animation:none; } .hero-dojo__video video { transition:none; } .hero-dojo__video-toggle:active { transform:none; } }
</style>
<section class="hero-dojo">
  <div class="hero-dojo__slashline" aria-hidden="true"></div>
  <div class="hero-dojo__img-layer">
    {%- if hero_poster_video != blank -%}
      <kitetzu-hero-video
        class="hero-dojo__video"
        data-label-pause="{{ 'accessibility.pause_video' | t | escape }}"
        data-label-play="{{ 'accessibility.play_video' | t | escape }}"
      >
        {%- if hero_picture != blank -%}
          {{ hero_picture }}
        {%- else -%}
          {{ hero_poster_video.preview_image | image_url: width: 1920 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', widths: '750, 1100, 1440, 1920', sizes: '100vw' }}
        {%- endif -%}
        <video playsinline muted loop preload="none" aria-hidden="true" tabindex="-1">
          {%- if hero_video != blank and hero_video_mobile != blank -%}
            {%- for video in hero_video_mobile.sources -%}
              {%- if video.format == 'mp4' -%}
                <source data-src="{{ video.url }}" type="{{ video.mime_type }}" data-media="(max-width: 767px)">
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- for video in hero_video_main.sources -%}
            {%- if video.format == 'mp4' -%}
              <source data-src="{{ video.url }}" type="{{ video.mime_type }}">
            {%- endif -%}
          {%- endfor -%}
        </video>
        <button type="button" class="hero-dojo__video-toggle" aria-label="{{ 'accessibility.pause_video' | t | escape }}">
          <span class="svg-wrapper hero-dojo__icon-pause" aria-hidden="true">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper hero-dojo__icon-play" aria-hidden="true">{{- 'icon-play.svg' | inline_asset_content -}}</span>
        </button>
      </kitetzu-hero-video>
    {%- else -%}
      {{ hero_picture }}
    {%- endif -%}
    <div class="hero-dojo__overlay"></div>
  </div>
  {%- if section.settings.kanji != blank -%}
    <div class="hero-dojo__kanji k-kanji-ghost" aria-hidden="true">{%- assign kanji_chars = section.settings.kanji | split: '' -%}{%- for char in kanji_chars -%}<span>{{ char }}</span>{%- endfor -%}</div>
  {%- endif -%}
  {%- if section.settings.vertical_text != blank -%}<div class="hero-dojo__vertical k-vertical" aria-hidden="true">{{ section.settings.vertical_text }}</div>{%- endif -%}
  <div class="hero-dojo__content">
    {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading_line_1 != blank -%}<h1 class="hero-dojo__heading">{{ section.settings.heading_line_1 }}{%- if section.settings.heading_line_2 != blank %} <span class="hero-dojo__ghostline">{{ section.settings.heading_line_2 }}</span>{%- endif -%}</h1>{%- elsif section.settings.heading_line_2 != blank -%}<h1 class="hero-dojo__ghostline">{{ section.settings.heading_line_2 }}</h1>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="hero-dojo__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="hero-dojo__ctas">
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}<a href="{{ section.settings.cta_url }}" class="k-btn k-btn--red">{{ section.settings.cta_label }}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>{%- endif -%}
      {%- if section.settings.cta_secondary_label != blank and section.settings.cta_secondary_url != blank -%}<a href="{{ section.settings.cta_secondary_url }}" class="k-link">{{ section.settings.cta_secondary_label }}</a>{%- endif -%}
    </div>
  </div>
  {%- if section.settings.meta_text != blank -%}
    <div class="hero-dojo__meta">
      <div class="hero-dojo__meta-inner">
        {%- assign meta_items = section.settings.meta_text | split: '·' -%}
        {%- for item in meta_items -%}<span>{{ item | strip }}</span>{%- unless forloop.last -%}<span class="dot" aria-hidden="true"></span>{%- endunless -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
{%- if hero_poster_video != blank -%}
  <script>
    if (!customElements.get('kitetzu-hero-video')) {
      customElements.define('kitetzu-hero-video', class extends HTMLElement {
        connectedCallback() {
          this.video = this.querySelector('video');
          this.toggleButton = this.querySelector('.hero-dojo__video-toggle');
          if (!this.video) return;
          this.onPlaying = () => this.setAttribute('data-playing', '');
          this.onToggle = () => this.toggle();
          this.video.addEventListener('playing', this.onPlaying);
          if (this.toggleButton) this.toggleButton.addEventListener('click', this.onToggle);
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const saveData = navigator.connection && navigator.connection.saveData;
          if (reducedMotion || saveData) {
            this.markPaused(true);
            return;
          }
          this.start();
        }

        start() {
          if (!this.loaded) {
            this.loaded = true;
            const sources = Array.from(this.video.querySelectorAll('source[data-src]'));
            const matching = sources.filter((source) => source.dataset.media && window.matchMedia(source.dataset.media).matches);
            const chosen = matching.length ? matching : sources.filter((source) => !source.dataset.media);
            for (const source of sources) {
              if (chosen.includes(source)) source.src = source.dataset.src;
              else source.remove();
            }
            if (!chosen.length) {
              this.setAttribute('data-static', '');
              return;
            }
            chosen[chosen.length - 1].addEventListener('error', () => this.setAttribute('data-static', ''), { once: true });
            this.video.load();
          }
          const playback = this.video.play();
          if (playback) playback.catch(() => this.markPaused(true));
        }

        disconnectedCallback() {
          if (this.video && this.onPlaying) this.video.removeEventListener('playing', this.onPlaying);
          if (this.toggleButton && this.onToggle) this.toggleButton.removeEventListener('click', this.onToggle);
        }

        toggle() {
          if (this.video.paused) {
            this.start();
            this.markPaused(false);
          } else {
            this.video.pause();
            this.markPaused(true);
          }
        }

        markPaused(paused) {
          this.toggleAttribute('data-paused', paused);
          if (this.toggleButton) {
            this.toggleButton.setAttribute('aria-label', paused ? this.dataset.labelPlay : this.dataset.labelPause);
          }
        }
      });
    }
  </script>
{%- endif -%}
{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "video", "id": "video", "label": "Hintergrund-Video", "info": "Ersetzt das Bild. Läuft stumm in Schleife mit Pause-Button. Bei „Bewegung reduzieren“ oder Datensparmodus startet es erst per Play-Button, bis dahin steht das Foto." },
    { "type": "video", "id": "mobile_video", "label": "Hintergrund-Video mobil (optional)", "info": "Hochformat-Video für Smartphones. Leer lassen, um das Hauptvideo auch mobil zu zeigen." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "ARC 01 — Live" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "KITETZU" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2 (outline)", "default": "AUS TINTE GESCHMIEDET." },
    { "type": "text", "id": "subheading", "label": "Absatz unter Heading line 2", "default": "ANIME INSPIRED STREETWEAR" },
    { "type": "text", "id": "kanji", "label": "Ghost-Kanji", "default": "鬼徹", "info": "Großes Kanji-Wasserzeichen rechts" },
    { "type": "text", "id": "vertical_text", "label": "Vertikaler Text (japanisch)", "default": "限定・百着" },
    { "type": "text", "id": "meta_text", "label": "Meta-Zeile (mit · trennen)", "default": "100 Stück · Kein Restock · Reflektierende Prints · 280 GSM" },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "ARC 01 ansehen" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Alles entdecken" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "default": 70, "unit": "%" },
    { "type": "range", "id": "min_height", "label": "Min height (svh)", "min": 40, "max": 100, "step": 5, "default": 95 }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
